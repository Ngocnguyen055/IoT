# After the first local run creates JSON credentials, export them with:
# .venv\Scripts\python.exe -m scripts.configure_env
# For a manual copy, fill all blank secrets and replace the sample MongoDB URI.
# .env is private and ignored by Git. Keep actual credentials out of this file.
ADMIN_PASSWORD=
DEVICE_KEY=
SESSION_SECRET=
DEVICE_ID=ngoc-01
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=IoTSOS
MONGODB_DATABASE=iot_sos
MONGODB_TIMEOUT_MS=5000
